-- RLS Policies: Allow authenticated users to access all data
CREATE POLICY "Authenticated users can view cabang" ON cabang FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can manage cabang" ON cabang FOR ALL TO authenticated USING (true);

CREATE POLICY "Authenticated users can view profiles" ON profiles FOR SELECT TO authenticated USING (true);
CREATE POLICY "Users can update own profile" ON profiles FOR UPDATE TO authenticated USING (auth.uid() = id);
CREATE POLICY "Users can insert own profile" ON profiles FOR INSERT TO authenticated WITH CHECK (auth.uid() = id);

CREATE POLICY "Authenticated users can view nasabah" ON nasabah FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can manage nasabah" ON nasabah FOR ALL TO authenticated USING (true);

CREATE POLICY "Authenticated users can view barang" ON barang_jaminan FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can manage barang" ON barang_jaminan FOR ALL TO authenticated USING (true);

CREATE POLICY "Authenticated users can view transaksi" ON transaksi_gadai FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can manage transaksi" ON transaksi_gadai FOR ALL TO authenticated USING (true);

CREATE POLICY "Authenticated users can view pembayaran" ON pembayaran FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can manage pembayaran" ON pembayaran FOR ALL TO authenticated USING (true);

CREATE POLICY "Authenticated users can view activity_log" ON activity_log FOR SELECT TO authenticated USING (true);
CREATE POLICY "Authenticated users can insert activity_log" ON activity_log FOR INSERT TO authenticated WITH CHECK (true);

-- Function to auto-create profile on signup
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER AS $$
DECLARE
  cabang_uuid UUID;
BEGIN
  SELECT id INTO cabang_uuid FROM cabang WHERE kode_cabang = 'CBG-001' LIMIT 1;
  INSERT INTO public.profiles (id, nama_lengkap, email, role, cabang_id)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'nama_lengkap', split_part(NEW.email, '@', 1)),
    NEW.email,
    COALESCE(NEW.raw_user_meta_data->>'role', 'kasir'),
    cabang_uuid
  );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Trigger for new user
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();

