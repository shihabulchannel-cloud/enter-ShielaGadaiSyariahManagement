
-- Enable UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Cabang (Branches) Table
CREATE TABLE IF NOT EXISTS cabang (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  kode_cabang TEXT NOT NULL UNIQUE,
  nama_cabang TEXT NOT NULL,
  alamat TEXT,
  telepon TEXT,
  email TEXT,
  kepala_cabang TEXT,
  status TEXT NOT NULL DEFAULT 'aktif' CHECK (status IN ('aktif', 'nonaktif')),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Profiles Table (linked to Supabase auth)
CREATE TABLE IF NOT EXISTS profiles (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  nama_lengkap TEXT NOT NULL,
  email TEXT NOT NULL,
  role TEXT NOT NULL DEFAULT 'kasir' CHECK (role IN ('super_admin', 'admin_cabang', 'kasir', 'owner')),
  cabang_id UUID REFERENCES cabang(id),
  telepon TEXT,
  foto_url TEXT,
  is_active BOOLEAN DEFAULT TRUE,
  last_login TIMESTAMPTZ,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Nasabah (Customers) Table
CREATE TABLE IF NOT EXISTS nasabah (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  kode_nasabah TEXT NOT NULL UNIQUE,
  nama_lengkap TEXT NOT NULL,
  nik TEXT NOT NULL UNIQUE,
  alamat TEXT,
  nomor_hp TEXT,
  pekerjaan TEXT,
  tanggal_lahir DATE,
  foto_ktp_url TEXT,
  foto_diri_url TEXT,
  cabang_id UUID REFERENCES cabang(id),
  is_active BOOLEAN DEFAULT TRUE,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Barang Jaminan (Collateral) Table
CREATE TABLE IF NOT EXISTS barang_jaminan (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  kode_barang TEXT NOT NULL UNIQUE,
  nama_barang TEXT NOT NULL,
  kategori TEXT NOT NULL CHECK (kategori IN ('emas', 'elektronik', 'kendaraan', 'sertifikat', 'lainnya')),
  merek TEXT,
  kondisi TEXT CHECK (kondisi IN ('sangat_baik', 'baik', 'cukup', 'kurang')),
  berat DECIMAL(10, 2),
  nomor_seri TEXT,
  estimasi_nilai DECIMAL(15, 2),
  lokasi_penyimpanan TEXT,
  status TEXT NOT NULL DEFAULT 'aktif' CHECK (status IN ('aktif', 'ditebus', 'jatuh_tempo', 'dilelang')),
  foto_urls JSONB DEFAULT '[]',
  nasabah_id UUID REFERENCES nasabah(id),
  cabang_id UUID REFERENCES cabang(id),
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Transaksi Gadai Table
CREATE TABLE IF NOT EXISTS transaksi_gadai (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nomor_transaksi TEXT NOT NULL UNIQUE,
  nasabah_id UUID NOT NULL REFERENCES nasabah(id),
  barang_id UUID NOT NULL REFERENCES barang_jaminan(id),
  cabang_id UUID REFERENCES cabang(id),
  nilai_pinjaman DECIMAL(15, 2) NOT NULL,
  ujrah_per_bulan DECIMAL(15, 2) NOT NULL,
  tanggal_gadai DATE NOT NULL DEFAULT CURRENT_DATE,
  tanggal_jatuh_tempo DATE NOT NULL,
  tanggal_pelunasan DATE,
  status TEXT NOT NULL DEFAULT 'aktif' CHECK (status IN ('aktif', 'diperpanjang', 'lunas', 'macet', 'lelang')),
  akad_digital TEXT,
  keterangan TEXT,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Pembayaran Table
CREATE TABLE IF NOT EXISTS pembayaran (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nomor_pembayaran TEXT NOT NULL UNIQUE,
  transaksi_id UUID NOT NULL REFERENCES transaksi_gadai(id),
  jenis_pembayaran TEXT NOT NULL CHECK (jenis_pembayaran IN ('ujrah', 'cicilan', 'pelunasan')),
  jumlah DECIMAL(15, 2) NOT NULL,
  metode TEXT NOT NULL CHECK (metode IN ('tunai', 'transfer', 'qris', 'ewallet')),
  tanggal_bayar TIMESTAMPTZ DEFAULT NOW(),
  keterangan TEXT,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Activity Log Table
CREATE TABLE IF NOT EXISTS activity_log (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID REFERENCES profiles(id),
  aksi TEXT NOT NULL,
  tabel TEXT,
  data_id UUID,
  ip_address TEXT,
  user_agent TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

